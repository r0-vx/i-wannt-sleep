# Runtime
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Persistence (SQLite is local-only; Compose uses PostgreSQL)
DATABASE_URL=postgresql+psycopg://forwardcheck:change-me@postgres:5432/forwardcheck
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=forwardcheck-private
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Providers — the pipeline fails explicitly when required keys are absent
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
BRAVE_SEARCH_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
IMAGE_SEARCH_PROVIDER=
IMAGE_SEARCH_API_KEY=

# Security and limits
SESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=http://localhost:3000
MAX_SOURCE_BYTES=2000000
SOURCE_TIMEOUT_SECONDS=10
MAX_CLAIMS=12
MAX_SOURCES_PER_CLAIM=4
MAX_UPLOAD_BYTES=15000000
RETENTION_DAYS_GUEST=7
RETENTION_DAYS_ACCOUNT=90

# Legal/contact configuration (required before public deployment)
SUPPORT_EMAIL=
SECURITY_EMAIL=
LEGAL_ENTITY_NAME=
LEGAL_JURISDICTION=

